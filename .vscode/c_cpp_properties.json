{
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/build/vcpkg_installed/x64-linux/include",
        "${workspaceFolder}/build/vcpkg_installed/arm64-osx/include"
      ],
      "defines": [
        "SPLINTER3D_DEBUG=0",
        "__WXGTK__",
        "wxUSE_GUI=1",
        "OCC_CONVERT_SIGNALS"
      ],
      "compilerPath": "/usr/bin/g++",
      "cppStandard": "c++23",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json"
    },
    {
      "name": "Windows",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/build/vcpkg_installed/x64-windows/include"
      ],
      "defines": [
        "SPLINTER3D_DEBUG=0",
        "__WXMSW__",
        "wxUSE_GUI=1",
        "OCC_CONVERT_SIGNALS"
      ],
      "compilerPath": "/usr/bin/g++",
      "cppStandard": "c++23",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json"
    }
  ],
  "version": 4
}
